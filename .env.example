# Copy to .env and edit. .env is git-ignored.

# --- Database (the password must match sql/01_create_database.sql) ---
DATABASE_URL=postgresql://expense_agent:CHANGE_ME@localhost:5432/expense_db
DB_SCHEMA=public

# --- Model (Ollama must be running: `ollama list`) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# --- Sampling per role: temperature / top_k / top_p / max new tokens ---
# Router picks the next tool (keep deterministic).
ROUTER_TEMPERATURE=0.0
ROUTER_TOP_K=20
ROUTER_TOP_P=0.8
ROUTER_NUM_PREDICT=64
# SQL writer (keep low).
SQL_TEMPERATURE=0.1
SQL_TOP_K=40
SQL_TOP_P=0.9
SQL_NUM_PREDICT=512
# Final answer wording.
ANSWER_TEMPERATURE=0.5
ANSWER_TOP_K=40
ANSWER_TOP_P=0.9
ANSWER_NUM_PREDICT=200

# --- Behaviour ---
# Relative dates ("yesterday", "last 10 days") use this timezone.
APP_TIMEZONE=Asia/Dhaka
MAX_STEPS=10
MAX_SQL_RETRIES=2
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=100
MAX_ROWS_TO_LLM=20
SCHEMA_SAMPLE_ROWS=3

# --- Cache and log (relative paths are inside the project folder) ---
CACHE_ENABLED=true
CACHE_PATH=data/sql_cache.json
CACHE_MAX_ENTRIES=500
LOG_PATH=logs/agent_log.jsonl
